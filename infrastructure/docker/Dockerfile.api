# ==============================================================================
# SevaHealth AI - API Gateway Production Container
# Base Image: Python 3.12 Slim (Debian Bookworm) - Pinned
# Security: Non-root execution, vulnerability minimized, healthcheck enabled
# ==============================================================================

FROM python:3.12-slim

# Set environment flags
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install minimal OS dependencies for network, health checks, and cryptography
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install pinned production dependencies
COPY requirements-prod.txt .
RUN pip install --no-cache-dir --upgrade pip==24.3.1 && \
    pip install --no-cache-dir -r requirements-prod.txt

# Create non-root application user for container isolation
RUN groupadd -r seva && useradd -r -g seva -d /app -s /sbin/nologin seva

# Copy application codebase
COPY . .

# Ensure non-root ownership
RUN chown -R seva:seva /app

USER seva

# Expose HTTP API Port
EXPOSE 8000

# Container Healthcheck Probe
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
