# ==============================================================================
# SevaHealth AI - Dedicated Multi-Agent AI Service Production Container
# Base Image: Python 3.12 Slim (Debian Bookworm) - Pinned
# ==============================================================================

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-prod.txt .
RUN pip install --no-cache-dir --upgrade pip==24.3.1 && \
    pip install --no-cache-dir -r requirements-prod.txt

RUN groupadd -r seva && useradd -r -g seva -d /app -s /sbin/nologin seva
COPY . .
RUN chown -R seva:seva /app

USER seva

EXPOSE 8004

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8004/health || exit 1

CMD ["python", "services/ai_agent/service_entrypoint.py"]
