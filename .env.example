# ==============================================================================
# SevaHealth AI - Environment Configuration Specification (.env.example)
# Standards: ABDM, FHIR R4, openEHR, DISHA Healthcare Privacy, Open Wearables
# Instructions: Copy this file to .env and customize secrets before startup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
ENVIRONMENT=production                 # development | staging | production | demo
APP_NAME=SevaHealth AI
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. SECURITY, IAM & DATA PROTECTION (DISHA / ABDM COMPLIANCE)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret key for HMAC-SHA256 JWT signing
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_64_CHAR_HEX_KEY_IN_PRODUCTION_ENV_9918231
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM symmetric key for PHI field-level encryption at rest (base64 encoded 32 bytes)
ENCRYPTION_AT_REST_KEY=eWVzdGhpcy1pcy1hLXNlY3VyZS0zMi1ieXRlLWtleS0xMjM=

# Allowed CORS Origins (comma-separated domains)
CORS_ALLOWED_ORIGINS=https://sevahealth.karnataka.gov.in,https://admin.sevahealth.karnataka.gov.in,http://localhost:3000,http://localhost:8000

# Rate Limiting & Anti-DDoS
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# ------------------------------------------------------------------------------
# 3. PRIMARY CLINICAL DATABASE (POSTGRESQL 16)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=seva
POSTGRES_PASSWORD=seva_prod_secret_password_change_me
POSTGRES_DB=sevahealth_db
POSTGRES_SSL_MODE=prefer
DATABASE_URL=postgresql+psycopg://seva:seva_prod_secret_password_change_me@postgres:5432/sevahealth_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. IN-MEMORY CACHE & MESSAGE BROKER (REDIS 7)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_POOL_MAX_CONNECTIONS=50

# ------------------------------------------------------------------------------
# 5. LONGITUDINAL CLINICAL REPOSITORY (EHRBASE 2.15.0 & OPEN-EHR DB)
# ------------------------------------------------------------------------------
EHRBASE_URL=http://ehrbase:8080/ehrbase/rest/openehr/v1
EHRBASE_USER=ehrbase-user
EHRBASE_PASSWORD=SuperSecretEhrPasswordChangeMe
EHRBASE_ADMIN_USER=ehrbase-admin
EHRBASE_ADMIN_PASSWORD=SuperSecretAdminPasswordChangeMe
EHRBASE_SERVER_NODENAME=sevahealth.karnataka.in
CLINICAL_REPOSITORY_BACKEND=hybrid     # postgresql | openehr | hybrid

# Dedicated openEHR Postgres Storage
EHRDB_HOST=ehrdb
EHRDB_PORT=5432
EHRDB_USER=ehrbase
EHRDB_PASSWORD=ehrbase_db_secret_change_me
EHRDB_NAME=ehrbase

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE / S3 MEDICAL VAULT (MINIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=sevahealth_minio_admin
S3_SECRET_KEY=sevahealth_minio_prod_secret_change_me
S3_BUCKET_NAME=sevahealth-medical-vault
S3_USE_SSL=false
MINIO_BROWSER_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 7. ASYNCHRONOUS WORKER & QUEUE POOL
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_QUEUES=document_ocr,wearable_backfill,ai_workflow,population_analytics,notification_dispatch
WORKER_POLL_INTERVAL_SEC=1.0

# ------------------------------------------------------------------------------
# 8. PERIODIC SCHEDULER & SURVEILLANCE CRON
# ------------------------------------------------------------------------------
SCHEDULER_HEARTBEAT_SEC=60
SCHEDULER_HABIT_REMINDERS_CRON="0 8 * * *"          # Daily at 08:00 AM
SCHEDULER_RISK_SURVEILLANCE_CRON="0 2 * * *"        # Daily at 02:00 AM
SCHEDULER_POPULATION_ROLLUP_CRON="0 4 * * 0"        # Weekly Sunday 04:00 AM

# ------------------------------------------------------------------------------
# 9. AI DECISION-INTELLIGENCE & MULTI-AGENT RUNTIME
# ------------------------------------------------------------------------------
AI_PROVIDER=MOCK                       # MOCK (for deterministic local/ci) | GEMINI | OPENAI
AI_MODEL_NAME=gemini-1.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=2048
AI_SAFETY_THRESHOLD=STRICT

# ------------------------------------------------------------------------------
# 10. OBSERVABILITY, METRICS & AUDIT
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=sevahealth_grafana_secret_change_me
GRAFANA_PORT=3001

# ------------------------------------------------------------------------------
# 11. REVERSE PROXY & GATEWAY (NGINX)
# ------------------------------------------------------------------------------
REVERSE_PROXY_HTTP_PORT=80
REVERSE_PROXY_HTTPS_PORT=443
NGINX_CLIENT_MAX_BODY_SIZE=25M

# ------------------------------------------------------------------------------
# 12. BACKUP & DISASTER RECOVERY
# ------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/sevahealth
BACKUP_RETENTION_DAYS=30
BACKUP_S3_SYNC_ENABLED=false
BACKUP_ENCRYPTION_PASSPHRASE=sevahealth_secure_backup_encryption_passphrase_2026
